NODE_ENV=production
PORT=3000

# Compte administrateur initial (obligatoire au premier démarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEZ_MOI_AVANT_DEPLOIEMENT_123!

# Email optionnel pour recevoir une notification à chaque demande
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=

# À activer si votre hébergeur utilise HTTPS et que votre application est derrière un proxy
COOKIE_SECURE=true

# Nombre de proxies de confiance devant Node (ex. 1 si Nginx/Caddy est devant l'application)
TRUST_PROXY=1
